---
import site from '../data/site.json';
import { withBase } from '../lib/url';

// ナビゲーション項目。必須コンテンツ 7 項目に対応。
const nav = [
  { href: '/about', label: '研究室概要' },
  { href: '/research', label: '研究テーマ' },
  { href: '/members', label: 'メンバー' },
  { href: '/publications', label: '業績' },
  { href: '/equipment', label: '装置・設備' },
  { href: '/join', label: '進学・配属希望の方へ' },
  { href: '/access', label: 'アクセス' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => current === withBase(href) || current.startsWith(withBase(href) + '/');
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="トップページへ">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-text">
        <span class="brand-main">{site.labNameShort}</span>
        <span class="brand-sub">{site.labName}｜{site.labNameAlt}</span>
      </span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="メニュー"><span></span></button>
    <nav class="nav" id="site-nav" aria-label="メインナビゲーション">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // スマートフォン用メニューの開閉
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  if (header && toggle) {
    toggle.addEventListener('click', () => {
      const open = header.classList.toggle('nav-open');
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
    });
  }
</script>
