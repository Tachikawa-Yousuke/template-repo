---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
  return research.map((entry, i) => ({ params: { id: entry.id }, props: { entry, index: i + 1 } }));
}
const { entry, index } = Astro.props;
const { Content } = await render(entry);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={entry.data.title} description={entry.data.summary}>
  <section class="page-head">
    <div class="container">
      <p class="label">Research Topic {pad(index)}{entry.data.tag && ` ｜ ${entry.data.tag}`}</p>
      <h1 class="display" style="font-size:clamp(1.8rem,5vw,3.6rem);font-family:var(--font-jp);font-weight:900;letter-spacing:-0.01em;line-height:1.2">{entry.data.title}</h1>
      <p class="page-sub en">{entry.data.titleEn}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="section-lead" style="margin-bottom:40px">{entry.data.summary}</p>
      {entry.data.image && <img src={withBase(`/images/research/${entry.data.image}`)} alt={entry.data.title} style="margin-bottom:40px" />}
      <div class="prose"><Content /></div>
      <p style="margin-top:48px"><a class="btn btn-outline" href={withBase('/research')}>← 研究テーマ一覧へ</a></p>
    </div>
  </section>
</Base>
