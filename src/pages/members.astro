---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';

const all = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order);
const faculty = all.filter((m) => m.data.group === 'faculty');
const students = all.filter((m) => m.data.group === 'student');
const alumni = all.filter((m) => m.data.group === 'alumni');
---
<Base title="メンバー">
  <section class="page-head">
    <div class="container">
      <p class="label">Members</p>
      <h1 class="display">メンバー</h1>
      <p class="page-sub">{site.foundedText}の若い研究室です。メンバーを積極的に募集しています。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="margin-bottom:16px">Faculty</p>
      {faculty.map(({ data }) => (
        <div class="pi-card">
          <div>
            {data.photo && <img class="member-photo" style="width:160px;height:160px;border-radius:0;margin-bottom:24px" src={withBase(`/images/members/${data.photo}`)} alt={data.name} />}
            <div class="pi-name">{data.name}</div>
            <div class="pi-name-en">{data.nameEn}</div>
            <div class="pi-role">{data.role}{data.roleEn && <span class="muted en" style="display:block;font-size:0.85rem;font-weight:400">{data.roleEn}</span>}</div>
            {data.interests.length > 0 && <ul class="chips">{data.interests.map((k) => <li>{k}</li>)}</ul>}
          </div>
          <div class="pi-bio"><p>{data.bio}</p></div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="label" style="margin-bottom:16px">Students</p>
      {students.map(({ data }) => (
        <div class="member-row">
          <span class="member-role">{data.role}</span>
          <span class="member-name">{data.name}{data.nameEn && <span>{data.nameEn}</span>}</span>
          <span class="muted" style="font-size:0.85rem">{data.interests.join(' / ')}</span>
        </div>
      ))}
      {students.length === 0 && <p class="muted">（学生メンバーは準備中です）</p>}
    </div>
  </section>

  {alumni.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="label" style="margin-bottom:16px">Alumni</p>
        {alumni.map(({ data }) => (
          <div class="member-row">
            <span class="member-role muted">—</span>
            <span class="member-name">{data.name}</span>
            <span class="muted" style="font-size:0.85rem">{data.role}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <p class="section-lead">興味があれば問い合わせフォームからお気軽にどうぞ。研究室見学・Web 面談は随時対応します。</p>
      <p style="margin-top:24px"><a class="btn" href={site.contactFormUrl} target="_blank" rel="noopener">問い合わせフォーム ↗</a></p>
    </div>
  </section>
</Base>
